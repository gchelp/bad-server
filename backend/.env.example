PORT=3000
#DB_ADDRESS=mongodb://root:example@mongo:27017/weblarek?authSource=admin - использовать эту переменную окружения, если запускаем в Docker
DB_ADDRESS=mongodb://127.0.0.1:27017/weblarek?authSource=admin
UPLOAD_PATH=images
UPLOAD_PATH_TEMP=temp
ORIGIN_ALLOW=http://localhost:5173
AUTH_REFRESH_TOKEN_EXPIRY=7d
AUTH_ACCESS_TOKEN_EXPIRY=1h
# Замените на свои длинные случайные строки (иначе секреты генерируются при каждом старте)
AUTH_ACCESS_TOKEN_SECRET=replace-with-long-random-string
AUTH_REFRESH_TOKEN_SECRET=replace-with-another-long-random-string
CSRF_SECRET=replace-with-third-long-random-string